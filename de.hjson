  "misc.spurdo.replyHint": "<b>Antworte auf die Nchrcht, welche du spurdo-fizieren mächtest :DD</b>"

  "misc.listcommands.main":
  '''
  <b>Fast jeder CalsiBot-Befehl:</b>

  <b>Bequeme Befehle:</b>
  /hug, /cuddle, /snuggle, /ruffle
  /pat, /poke, /highfive

  <b>Spiele:</b>
  /fish, /marry, /divorce

  <b>Spielbefehle:</b>
  /slap, /wish, /judge, /coin (/flip)
  /roll, /dox
  /kms, /kys, /kos

  <b>Gruppenadministrationsbefehle:</b>
  /kick, <code>/kickme</code>, /ban, /permaban
  /mute (/restrict), /unrestrict (/unban), /warn
  /pin, /unpin, /title, /chatname, /pfp
  /SetWelcome, /RemoveWelcome
  /JoinLimit, /JoinLock
  /JoinVerify, /PreVerify

  <b>Befehle zur Textänderung:</b>
  /spurdo, /emojify

  <b>Andere:</b>
  /boi, /denko, /huh
  /name, /me, /edgy
  <a href="t.me/CalsiBotDev/51">"sed" (Textumschaltung -ersetzung)</a>

  <b>Nützliche Funktionen:</b>
  /stickers, <code>@admin</code>, /language
  /translate (/tr), /when, /count
  '''

  # ℹ️ Example: It's
  #             Alex Wayne"
  "misc.name.main": "Es ist:\n<b>%s</b>"

  "misc.me.main":
  '''
  <b>Infokarte für </b>%s<b>:</b>

  <code>Nutzername: </code>%s
  <code>Benutzeridentifikation: </code>%s
  <code>Gruppen-ID: </code>%s
  '''

  "misc.wish.help":
  '''
  <b>Sie können </b><code>/wish</code><b> als allgemeine Art von Wunschbrunnen verwenden

  Beispielsweise:</b>
  <code>/wish ich könnte mit dir ausgehen 😍</code><b>, or</b>
  <code>/wish das Sushi wäre 🍣 in /emojify</code><b>, or</b>
  <code>/wish ich hatte jemanden zum /cuddle in der Nacht</code><b>...</b>
  '''

  "misc.wish.main": "<b>Dein Wunsch wurde gewirkt. ✨</b>\n\n<i>erfolgschance: %s%</i>"

  "misc.adminmode.help": "<b>Im Administratormodus können Sie alle CalsiBot-Befehle deaktivieren, die sich nicht auf die Gruppenverwaltung beziehen.</b>"
  "misc.adminmode.sorry": "<b>Entschuldigung, der Admin-Modus ist aktiviert, daher können Sie diesen Befehl hier nicht verwenden...</b>\n\n%s"

  "misc.sedreplace.main": "Meintest du:"

  "misc.pfp.help": "<b>Auf ein komprimiertes Bild antworten (nicht als Datei gesendet), das Sie als Gruppenprofilbild festlegen möchten</b>"

  "misc.slap.CalsiBot": "<b>Du kannst mich nicht schlagen, so funktioniert das einfach nicht...</b>"

  "misc.when.forwardMain": "📅 Ursprünglich veröffentlicht am <b>%s</b> um <b>%s</b> (UTC)\n\n⏳ Das ist <b>%s</b> her."
  "misc.when.otherMain": "⏳ Diese Nachricht wurde vor <b>%s</b> gesendet."
  "misc.when.otherEdit": "\n\n✏️ Zuletzt bearbeitet vor <b>%s</b>."
  "misc.when.help": "<b>Antworten Sie auf eine Nachricht, um zu sehen, wie lange es her ist, seit sie veröffentlicht wurde - bis auf die Sekunde genau.\n\nBei weitergeleiteten Nachrichten sehen sie wann die uhrsrüngliche Nachricht zum ersten Mal veröffentlicht wurde.</b>"

  "misc.count.main": "<b>Diese Supergruppe hatte seit ihrer Gründung </b><code>%s</code><b> Nachrichten insgesamt, einschließlich Ihrer</b>"

  "misc.pin.help": "<code>/pin</code> <b>ermöglicht es Ihnen, die Chat-PIN ohne dumme Menüs einfach festzulegen oder zu ändern\n\nSie wissen immer noch nicht, wie Sie es verwenden sollen? Tippen Sie auf die Schaltfläche unten, um ein Beispiel anzuzeigen:</b>"
  "misc.pin.main": "<b>Auf ein komprimiertes Bild antworten (nicht als Datei gesendet), das Sie als Gruppenprofilbild festlegen möchten</b>"

  # ℹ️ Example: Couldn't find any\n- non-animated sticker 😕\n\nTry again with a different message.
  "misc.fileIDSearch.error.noUsableFileFound": "<b>Konnte keine finden:</b>\n%s. 😕\n\n<b>Versuchen Sie es erneut mit einer anderen Nachricht.</b>"

  # ℹ️ Example: Come over here, get on your knees, and translate this 😏
  "misc.knees.main": "<b>Komm her, geh auf die Knie, und </b><i>%s</i><b> das %s</b>"


