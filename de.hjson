     --------------------------------------------------------------------- */
  "fish.fish": "Fisch"
  "fish.fishing": "Angeln"
  "fish.noFish": "<b>Es sieht so aus als ob </b><a href=\"tg://user?id=%s\">%s</a><b> noch nie zuvor einen Fisch gefangen hätte!\n\nProbieren Sie es aus:</b> /Fish"
  "fish.noTrophyFish": "<b>Sie haben derzeit keinen Trophäenfisch 😢 - aber keine Sorge!\n\nFang einen </b>/Fish<b> um deinen ersten zu verdienen!</b>\n\n/MyFish ||| /Fish"

  "fish.verdicts": {
    "failure": "Genau wie im wirklichen Leben, <b>beißt nichts an.</b>"
    "blowfish": "Sie haben einen Kugelfisch gefangen: 🐡"
    "normal": "<b>Nicht schlecht!</b>\nDu hast einen normalen Fisch gefangen: 🐟"
    "tropical": "<b>Cool!</b>\nDu hast einen tropischen Fisch gefangen: 🐠"
    "squid": "<b>Süß!</b>\nDu hast einen Tintenfisch gefangen: 🦑"
    "crab": "<b>Genial!</b>\nDu hast einen Krebs gefangen: 🦀"
    "dolphin": "<b>WHOA!</b>\nDu hast einen Delphin gefangen: 🐬"
    "shark": "<b>GOTT VERFICKTE SCHEISSE!!</b>\nDu hast einen Hai gefangen: 🦈"
    "crocodile": "<b>ARGHHH!!!</b>\nDu hast ein Krokodil gefangen: 🐊"
    "whale": "<b>DER OZEAN SCHEINT ZU VERSINKEN...\n\nMit all deiner Kraft taumelst du in deinem Fang!</b>\nDu hast einen Wal gefangen: 🐳"
  }

  "fish.viewYourFish": "\n\n<b>Betrachte deine Fische:</b> /MyFish"
  "fish.newTrophyFish": "\n\n<b>🎉 Du hast gerade einen neuen </b>\n/TrophyFish verdient!"

  "fish.myFish":
  '''
  <b>🎣 </b><a href="tg://user?id=%s">%s</a><b> – Fisch:</b>

  🐡 - Kugelfisch: <b>%s</b>
  🐟 - Normaler Fisch: <b>%s</b>
  🐠 - Tropischer Fisch: <b>%s</b>
  🦀 - Tintenfisch: <b>%s</b>
  🦑 - Krebs: <b>%s</b>
  🐬 - Delphin: <b>%s</b>
  🦈 - Hai: <b>%s</b>
  🐊 - Krokodil: <b>%s</b>
  🐳 - Wal: <b>%s</b>

  🐠🦑🐊 - Alle Fische: <b>%s</b>

  /TrophyFish ||| /Fish
  '''

  "trophy.types": {
    "firstfish": "\n%s<%s> - Erster Fisch!</%s>"
    "1000fish": "\n%s<%s> - Tausend Fische</%s>"
