  /* ---------------------------------------------------------------------
                  Stickers - Used for all /sticker commands
     --------------------------------------------------------------------- */
  "stickers.defaultPackTitle": "%ss Favoriten"
  "stickers.acceptableFileTypes": "<b>- GIF,\n- komprimiertes Foto,\n- unkomprimiertes Foto</b> (&lt;10 MB)<b>,\n- Video</b> (&lt;10 MB)<b>,\n- Foto-, animierte oder Video-Sticker</b>"
  "stickers.main": "<b>Erstellen, verwalten und hinzufügen zu Aufkleberpackungen mit den folgenden Befehlen:</b>\n\n/newpack - Erstellen Sie ein neues Paket\n/listpacks - Listen Sie Ihre Packungen und ihre IDs auf\n/renamepack — eine Aufkleberpakung umbenennen\n/removepack - Verknüpfung eines Pakets mit CalsiBot aufheben\n\n/addsticker - Aufkleber zu einer Packung hinzufügen\n/deletesticker - Aufkleber aus einer Packung löschen\n\n<b>Experteneinsatz:</b>\n\n/addsticker 3 — Fügen Sie ein Bild oder einen Aufkleber der Packung mit der ID <code>3</code> hinzu\n/addsticker 🥳🙂😉 — Erstellen Sie einen Aufkleber und schlagen Sie ihn vor, wenn Sie einen dieser drei Emoji verwenden\n/addsticker 3 🥳🙂😉 — Erstellen Sie einen Aufkleber und fügen Sie ihn zu Packung <code>3</code> hinzu, schlagen Sie ihn vor, wenn Sie eines dieser drei Emoji verwenden"
  "stickers.beingAdded": "⏳ <b>Ihr Aufkleber wird hinzugefügt, bitte warten Sie...</b>"
  "stickers.beingAddedQueued": "⏳ <b>Ihr Aufkleber wird in %s hinzugefügt, bitte warten Sie...</b>"
  "stickers.beingAddedSuccess": "🥳 <b>Dein Aufkleber wurde hinzugefügt!</b>\n\n<i>Wenn Sie ihn nicht sehen, entfernen Sie die Stickerpackung und fügen Sie ihn erneut hinzu:</i>"
  "stickers.beingDeleted": "<b>Dieser Aufkleber wurde entfernt.</b>\n\n<i>Das Verschwinden kann bis zu 2 Minuten dauern:</i>"
  "stickers.letsCreateAPackInPrivate": "<b>Aufkleberpackungen müssen privat erstellt werden. Los geht's:</b>"
  "stickers.removeOnlyInPrivate": "<b>Aufkleberpackungen können nur privat entfernt werden. Los geht's:</b>"
  "stickers.seeAllCommandsHint": "<b>Sende /stickers um alle Befehle und Informationen zu sehen.</b>"
  "stickers.videoTrimmedHint": "<i>Tipp: Beim Hinzufügen von Videos können nur die ersten 3 Sekunden verwendet werden. Schneiden Sie sie selbst zu, bevor Sie sie hinzufügen, um einen bestimmten Teil auszuwählen.</i>"
  "stickers.whichPackShouldBeAddedTo": "<b>Zu welcher Packung sollte der Aufkleber hinzugefügt werden?</b>\n\n%s"

  "stickers.callbacks": {
    "confirmStickerPackCreateOrRename": "<b>Ihre Aufkleberpackunghat den folgenden Titel:</b>\n\n<code>%s</code>\n\n<b>Drücken Sie Abbrechen, um einen anderen Titel auszuwählen.</b>"
    "cancelStickerPackCreateOrRename": "<b>Okay, wählen Sie einen anderen Titel und versuchen Sie es erneut. Zum Beispiel:</b>\n\n<code>/newpack %s</code>"
    "stickerPackCreateSuccess": "<b>Ihre Aufkleberpackung wurde erstellt!</b>\n\nSie können jetzt auf Bilder und Aufkleber mit /addsticker antworten, um sie Ihrer Packung hinzuzufügen\n\n%s"
    "stickerPackRenameSuccess": "<b>Ihre Aufkleberpackung wurde umbenannt!</b>\n\n%s"
    "confirmStickerPackRemove": "⚠️ <b>Ihre Aufkleberpackung wird von CalsiBot getrennt.\n\nSie können diese Packung nie wieder mit CalsiBot aktualisieren.\n\nSind Sie sicher, dass Sie diese Packung entfernen möchten?</b>"
    "cancelStickerPackRemove": "<b>Okay, Packung wurde nicht entfernt.</b>"
    "stickerPackRemoveSuccess": "<b>Ihre Aufkleberpackung wurde aus CalsiBot entfernt.</b>\n\nUm sie vollständig zu löschen, wenden Sie sich an @Stickers"
    "cancelAddEmojiToMessage": "<b>Okay, Sie können selbst ein anderes Emoji angeben. Zum Beispiel:</b>\n\n<code>%s</code>"
  }

  "stickers.listPacks": "<b>Ihre Packungen:\n\n%s</b>\n\n%s"
  "stickers.listPacksFill": "%s — <a href=\"%s\">%s</a>"
  "stickers.validStickerPacksAre": "<b>Gültige Aufkleberpackungs-IDs sind:\n<code>%s</code></b>"

  "stickers.error": {
    "noTitleGiven": "<b>Sie müssen einen Titel angeben. Zum Beispiel:</b>\n\n<code>/%s %s</code>"
    "noPackGiven": "<b>Sie müssen eine Packung angeben. Zum Beispiel:</b>\n<code>/%s %s</code>\n\n%s"
    "noEmojiGiven": "<b>Bitte wählen Sie unten ein Emoji aus\n\nDrücken Sie Abbrechen, um Ihr eigenes anzugeben:</b>\n<code>%s</code>"
    "noStickerPacks": "<b>Sie haben keine Aufkleberpackungen.</b>\n\n%s"
    "specifiedPackDoesNotExist": "<b>Auskleberpackung nicht gefunden werden <code>%s</code></b>\n\n%s"
    "stickerAlreadyDeleted": "<b>Dieser Aufkleber wurde bereits gelöscht.</b>"
    "packFull": "<b>Diese Packung ist voll, lösche einige Aufkleber daraus oder erstelle ein neues Paket.</b>"
    "packLimitReached": "<b>Sie haben das Limit an %s Aufkleberpackungen erreicht.\n\nWenn Sie ein neue Packung erstellen möchten, müssen Sie </b><code>/removepack</code><b> verwenden, um zuerst eine andere zu entfernen.</b>"
    "addStickerReplyHint": "<b>Antworten Sie auf die Medien, die Sie einer Aufkleberpackung hinzufügen möchten.</b>"
    "deleteStickerReplyHint": "<b>Antworten Sie auf einen Aufkleber aus einer Ihrer Packungen den Sie löschen möchten.</b>"
  }
