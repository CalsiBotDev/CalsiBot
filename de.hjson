  /* ---------------------------------------------------------------------
                      Comfy - Used for /hug, /cuddle, etc.
     --------------------------------------------------------------------- */
  "comfy.hug": {
    "self": "%s<b> fässt mit einem Arm um sich und umarmt ihren eigenen Körper. </b>%s<b> fühlt sich jetzt etwas weniger allein.</b>"
    "main": "%s gab dir gerade ein <b>hug! :)</b>"
    "CalsiBot": "<i>Ich kann nicht umarmt werden </i><b>:/</b>"
  }

  "comfy.cuddle": {
    "self": "%s<b> legt sich mit dem Gesicht nach unten auf das bett und versucht beide seiten zu kuscheln. </b>%s<b> fühlt sich jetzt etwas weniger traurig.</b>"
    "main": "%s kuschelt %s fest"
    "CalsiBot": "<i>seufz</i> ☁️😌☁️"
  }

  "comfy.snuggle": {
    "self": "%s<b>zieht die Knie hoch und versucht sich selbst zu kuscheln. </b>%s<b> fühlt sich jetzt etwas weniger ungeliebt.</b>"
    "main": "%s kuschelt sich zufrieden an %s"
    "CalsiBot": "🥺 <i>*Entspannte Bot-Geräusche*</i>"
  }

  "comfy.poke": {
    "self": "%s<b> stupst die eigene Hüfte und wird dabei erinnert etwas abzunehmen</b>"
    "main": "<b>*</b>%s stupst %s<b>* o_o</b>"
    "CalsiBot": "<b>&gt;_&lt;</b>"
  }

  "comfy.pat": {
    "self": "%s<b> bewegt unbeholfen eine Hand um sich auf den Kopf zu klopfen. 🙃</b>"
    "main": "<b>*</b>%s Klopft %s auf den kopf<b>* :V</b>"
    "CalsiBot": "<i>rawr</i> <b>;D</b>"
  }

  "comfy.ruffle": {
    "self": "%s<b> wuschelt sich die Haare... . Meh. 😐</b>"
    "main": "<b>*</b>%s wuschelt %s's Haar<b>* :&</b>"
    "CalsiBot": "<i>Du sollst die Haare auf meinem Kopf streicheln...nicht...da.</i> 😳"
  }

  "comfy.highfive": {
    "self": "%s<b> versucht, durch zusammenschlage der eigenen zwei Hände, sich selbst zu ein Highfive zu geben. </b>%s<b> verfehlt und versinkt tiefer in Depression</b>"
    "main": "%s gibt dir dafür ein <b>high-fived</b>!"
    "CalsiBot": "<i>:D</i>"
  }


