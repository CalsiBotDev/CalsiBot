  /* ---------------------------------------------------------------------
                        JoinEvents - Used for Join Flow
     --------------------------------------------------------------------- */
  "joinevents.error.CalsiBotNotEnoughPermissions": "<b>Eine Willkommensnachricht, JoinLock, JoinVerify oder JoinLimit ist derzeit aktiviert, aber ich habe momentan nicht genügend Administratorrechte...\n\nBitte stellen Sie sicher, dass ich die </b><code>Gruppeninfo ändern</code><b> und </b><code>Benutzer sperren</code><b>.</b> kann"
  "joinevents.userPermabanned": "%s<b> wurde von einem Administrator dauerhaft aus dieser Gruppe ausgeschlossen\n\nIch habe sie entfernt.</b>"
  "joinevents.joinlockAddedByAdmin": "<b>Join Lock ist aktiviert, aber </b>%s<b> wurde von </b>%s<b> hinzugefügt, sie wurden also nicht raus geworfen.</b>"
  "joinevents.joinlockMemberBanned": "%s<b> wurde gesperrt, weil Join Lock aktiviert ist</b>"

  /* ---------------------------------------------------------------------
                        JoinConfig - Used for Join Flow
     --------------------------------------------------------------------- */
  "joinconfig.welcome.help": "<code>/SetWelcome</code><b> Hier können Sie eine Begrüßungsnachricht für Ihren Chat einrichten\n\nIhre Nachricht sollte wie folgt aussehen:</b>"
  "joinconfig.welcome.error.somethingWrong": "<b>Es tut uns leid, aber mit der von Ihnen geposteten Nachricht stimmt etwas nicht.\n\nBitte überprüfen Sie Ihre Formatierung und stellen Sie sicher, dass Sie keine seltsamen Zeichen eingefügt haben.</b>"
  "joinconfig.welcome.success": "<b>Großartig, Ihre neue Begrüßungsnachricht wurde festgelegt. Oben können Sie überprüfen wie es aussehen wird!\n\nSie können </b><code>/DeleteWelcome</code><b> verwenden, um es zu entfernen.</b>"
  "joinconfig.welcome.removed": "<b>Die Begrüßungsnachricht wurde entfernt.\n\nSie können </b><code>/SetWelcome</code><b> verwenden, gefolgt von der Nachricht die Sie möchten, um eine neue festzulegen.</b>"
  "joinconfig.welcome.notSet": "<b>Derzeit ist keine Begrüßungsnachricht zum festgelegt.\n\nSie können </b><code>/SetWelcome</code><b>, gefolgt von der Nachricht die Sie festlegen möchten, verwenden.</b>"

  "joinconfig.joinlimit.help": "<code>/JoinLimit</code><b> Mit dieser Option können Sie die Standardeinschränkungen für alle Mitglieder festlegen, die an Ihrem Chat teilnehmen\n\nIhre Nachricht sollte wie folgt aussehen:</b>"
  "joinconfig.joinlimit.success": "<b>Ihr </b><code>/JoinLimit</code><b> wurde gesetzt!</b>\n\nNeue Mitglieder werden automatisch eingeschränkt %s, bis ein Administrator die Einschränkung aufhebt."
  "joinconfig.joinlimit.successTimed": "<b>Ihr </b><code>/JoinLimit</code><b> wurde gesetzt!</b>\n\nNeue Mitglieder werden automatisch eingeschränkt %s für das von Ihnen angegebene Zeitlimit."

  "joinconfig.title.help": "<code>/%s</code><b> ermöglicht es Ihnen, den Titel des Chats mit einer Nachricht festzulegen\n\nIhre Nachricht sollte folgendermaßen lauten:</b>\n<code>/%s Neuer Chat-Titel</code>\n\n<b>Tipp: </b><i>Haben Sie einen Chatnamen, den Sie immer in Titeln verwenden? Auschecken </i>/cn"
  "joinconfig.title.replyToTextHint": "<b>Wenn Sie auf eine andere Nachricht antworten, um den Chat-Titel festzulegen, muss dieser nur aus Text bestehen.</b>\n\n<b>Tipp: </b><i>Haben Sie einen Chatnamen, den Sie immer in Titeln verwenden? Auschecken </i>/cn"

  "joinconfig.chatname.help": "<code>/%s</code><b> Hier können Sie den Namen des Chats festlegen. Dieser Name wird immer vor allen Chat-Titeln angezeigt, die mit festgelegt wurden </b><code>/t</code> <b>oder</b> <code>/title</code><b>.\n\nIhre Nachricht sollte folgendermaßen lauten:</b>\n<code>/%s MeinChatName</code>"
  "joinconfig.chatname.replyToTextHint": "<b>Wenn Sie auf eine andere Nachricht antworten, um den Namen des Chats festzulegen, darf dieser nur aus Text bestehen.</b>"
  "joinconfig.chatname.success": "<b>Ihr Chat-Name wurde festgelegt auf:</b>\n%s\n\nDies wird am Anfang jedes Chat-Titels angezeigt, der mit <code>/t</code> oder <code>/title</code> festgelegt wurde."


  /* ---------------------------------------------------------------------
                        JoinVerify - Used for /JoinVerify
     --------------------------------------------------------------------- */
  # ⚠️ IMPORTANT
  "joinverify.callbacks": {
    "correctAnswerText": "Richtig! %s noch..."
    "incorrectAnswerText": "Falsch. Noch 3 weitere..."
    "success": "<b>Erfolg!\n\nGute Arbeit, Mensch, du kannst jetzt in: </b><code>%s</code> chatten"
