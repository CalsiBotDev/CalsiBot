    "main": "%s coccola %s forte forte"
    "CalsiBot": "<i>sighhh</i> ☁️😌☁️"
  }

  "comfy.snuggle": {
    "self": "%s<b> si rannicchia in posizione fetale. </b>%s<b> ora si sente leggermente meglio</b>"
